{
  "name": "dsh-pluginmax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Out-of-tree DSH collaboration plugins",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run contract && pnpm run pack:check",
    "contract": "node scripts/contract.mjs",
    "format:check": "pnpm exec prettier --check .",
    "lint": "pnpm exec oxlint packages plugins",
    "pack:check": "pnpm --filter './packages/*' --filter './plugins/*' pack --dry-run",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "oxlint": "1.76.0",
    "prettier": "^3.6.2",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
